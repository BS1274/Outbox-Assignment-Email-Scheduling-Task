{
  "name": "reachinbox-email-scheduler",
  "private": true,
  "scripts": {
    "build": "npm --prefix frontend run build",
    "dev:api": "npm --prefix backend run dev",
    "dev:worker": "npm --prefix backend run dev:worker",
    "dev:web": "npm --prefix frontend run dev",
    "dev": "concurrently -n api,worker,web -c blue,magenta,green \"npm run dev:api\" \"npm run dev:worker\" \"npm run dev:web\"",
    "test": "npm --prefix backend test",
    "typecheck": "npm --prefix backend run typecheck && npm --prefix frontend run typecheck",
    "db:migrate": "npm --prefix backend run db:deploy",
    "smoke": "npm --prefix backend run smoke",
    "plan:demo": "npm --prefix backend run plan:demo"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "vercel": "^65.9.0"
  }
}
