# Copy to .env and fill in the real credentials. Never commit .env.

# --- Data stores (docker compose defaults) ---
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5432/reachinbox
REDIS_URL=redis://127.0.0.1:6379
ELASTICSEARCH_URL=http://127.0.0.1:9200

# --- HTTP ---
PORT=4000
FRONTEND_URL=http://localhost:5173
# Public URL of this API. Google and Slack redirect here.
APP_URL=http://localhost:4000

# Signs the session cookie. Use a long random string.
JWT_SECRET=your-super-secret-jwt-key-replace-in-env

# --- Scheduler knobs (no hardcoded limits in code) ---
# How many jobs one worker process may run at the same time.
WORKER_CONCURRENCY=5
# Minimum gap between two sends from the same sender. 2000 = 2 seconds.
MIN_SEND_DELAY_MS=2000
# Hard cap per sender. The compose form can only go lower than this.
MAX_EMAILS_PER_HOUR_PER_SENDER=200
# How many Ethereal mailboxes to create the first time a user schedules.
ETHEREAL_ACCOUNTS_PER_USER=2
# BullMQ SMTP retries after a real provider error. This is not a cron.
EMAIL_MAX_ATTEMPTS=5

# --- BullMQ dashboard basic auth (/admin/queues) ---
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=your-bullboard-password-replace-in-env

# --- Google OAuth (required for login) ---
# Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_CALLBACK_URL exactly.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# --- Slack OAuth (required for rate-limit notifications) ---
# Create an app: https://api.slack.com/apps
# OAuth scope: incoming-webhook
# Redirect URL must match SLACK_CALLBACK_URL exactly.
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_CALLBACK_URL=http://localhost:4000/api/slack/callback
